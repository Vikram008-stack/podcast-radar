{
  "name": "podcast-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:sample": "tsx --conditions=react-server scripts/seed-sample.ts",
    "pipeline:weekly": "tsx --conditions=react-server scripts/pipeline-weekly.ts",
    "sources:validate": "tsx --conditions=react-server scripts/validate-sources.ts",
    "test:integration": "vitest run tests/integration",
    "check:live": "tsx --conditions=react-server scripts/live-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
