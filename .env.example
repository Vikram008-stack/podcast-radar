# Podcast Ecosystem Radar — copy to .env.local (local) and set the same names in Vercel + GitHub.
# Nothing secret may use the NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_APP_URL=                # e.g. https://podcast-radar.vercel.app (magic-link redirect base)
NEXT_PUBLIC_SUPABASE_URL=           # Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase publishable (anon) key — safe for the browser, RLS protects data
SUPABASE_SERVICE_ROLE_KEY=          # server only — Supabase secret key (pipeline + admin)
SUPABASE_DB_URL=                    # tooling only (npm run db:migrate) — session pooler URI, never used by the app
ALLOWED_EMAIL=                      # Aditya's sign-in email (the only account allowed)

GEMINI_API_KEY=                     # server only, Google AI Studio free tier
GEMINI_MODEL=gemini-3.6-flash       # current stable free-tier Flash model (verified 11 Oct 2026)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash   # used only when the primary is out of quota / 503
GEMINI_MAX_CALLS_PER_RUN=45         # per-run budget (free tier)

YOUTUBE_API_KEY=                    # server only, YouTube Data API v3 (official), no billing
RAPIDAPI_KEY=                       # server only, RapidAPI Spotify Scraper (DataFanatic) BASIC $0 plan
RAPIDAPI_SPOTIFY_HOST=spotify-scraper.p.rapidapi.com
SPOTIFY_MONTHLY_BUDGET=120          # BASIC = 150 requests / month; keep headroom

CRON_SECRET=                        # long random string (openssl rand -hex 32)

REPORT_TIMEZONE=Asia/Kolkata
REPORT_HOUR=6
REPORT_MINUTE=0
MIN_EPISODE_MINUTES=20
AUDIO_CLIP_MINUTES=10
AUDIO_MAX_EPISODES_PER_RUN=40
SAMPLE_DATA_MODE=false              # local dev only — ignored when VERCEL_ENV=production
PUBLIC_READ=false                   # true = anyone with the link can VIEW the brief; edits still need sign-in
PUBLIC_EDIT=false                   # true = anyone with the link can also EDIT (drafts, Settings, scans) — rate limits still apply

# Optional: "Run scan now" dispatches the GitHub Actions workflow (full run incl. audio)
GITHUB_DISPATCH_TOKEN=              # fine-grained PAT, this repo only, Actions: read & write
GITHUB_REPO=                        # owner/repo
